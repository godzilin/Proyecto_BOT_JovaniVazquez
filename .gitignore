# ignoran los archivos personales de cada desarrollador.
.vscode/*
!.vscode/settings.json
.idea/
.DS_Store

# Estado y log de actualizar.sh en el NAS
.despliegue/

# Dependencias de Node de las escenas (package.json)
node_modules/
