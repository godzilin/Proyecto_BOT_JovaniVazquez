# Entorno de Python
.venv/
venv/
__pycache__/
*.pyc

# Configuración local con secretos
.env
.data/

# Artefactos de build/empaquetado
build/
dist/
*.egg-info/

# Cachés de herramientas
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Archivos de editor/SO
# Se comparte .vscode/settings.json (configuración de equipo), pero se
# ignoran los archivos personales de cada desarrollador.
.vscode/*
!.vscode/settings.json
.idea/
.DS_Store

# Estado y log de actualizar.sh en el NAS
.despliegue/

# Informes de uso diarios que deja el bot (docker-compose.yml)
informes/

# Dependencias de Node de las escenas (package.json)
node_modules/

# Paquetes de sonido descargados por docs/sonidos_tragas.py
docs/.sonidos_cache/

# Copias de trabajo de los subagentes
.claude/worktrees/

# Página compilada del Jovaniverso (`npm run build` en universo/; la compila la imagen)
src/bot/assets/universo/

# Capturas de las pruebas de la página del Jovaniverso (docs/probar_casino.py, docs/medir_universo.py)
docs/capturas_universo/
