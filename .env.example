# Copia este archivo a .env y completa el token. NUNCA subas .env al repositorio.

# Token del bot (portal de desarrolladores de Discord > Bot > Reset Token). Obligatorio.
DISCORD_TOKEN=

# Nivel de logs: DEBUG, INFO, WARNING, ERROR. Opcional (por defecto INFO).
LOG_LEVEL=INFO

# Prefijo de los comandos de texto (.play, .help...). Opcional (por defecto ".").
# Los comandos de aplicación (/play, /help...) funcionan siempre, sea cual sea.
COMMAND_PREFIX=.

# Canales donde se juega al casino (ruleta, blackjack y tragaperras): IDs
# separados por comas. Opcional.
# Vacío = cualquier canal. En nuestro servidor, #casino es 1384280704539562054.
CASINO_CHANNEL_IDS=

# Clave de The Odds API (https://the-odds-api.com, plan gratis de 500 créditos al mes)
# para las apuestas deportivas (`deportes`). Opcional y secreta: vacía, `deportes`
# avisa de que no está configurado y el bot no pide cuotas.
ODDS_API_KEY=

# Jovaniverso (`universo`, la Activity de Discord). Opcional. Pasos en el README,
# «Jovaniverso (Activity)».
# Secreto de OAuth2 de la aplicación (portal de desarrolladores > OAuth2 > Client
# Secret). Secreto. Vacío, el servidor web no se abre y `universo` avisa de que aún
# no está abierto.
DISCORD_CLIENT_SECRET=
# Puerto del servidor web dentro del contenedor (por defecto 8080). Opcional.
UNIVERSO_PORT=8080
# Para docker compose, no para el bot: `universo` arranca el túnel de Tailscale
# Funnel (servicio `tunel` de docker-compose.yml) y TS_AUTHKEY es la clave con que
# entra en Tailscale la primera vez (secreta: Settings > Keys de Tailscale).
COMPOSE_PROFILES=
TS_AUTHKEY=
